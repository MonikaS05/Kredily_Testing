{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Kredily HRMS API Testing Suite",
    "description": "Comprehensive API test suite for Kredily HRMS backend covering Authentication, Attendance, and Leave Management across Positive, Negative, and Edge scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
