              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"REQ-INVALID-999\",\n  \"action\": \"APPROVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/regularize/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "regularize", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request or 404 Not Found\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "});",
                  "pm.test(\"Error matches BUG-004 behavior (Attendance log not found)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.match(/Attendance log not found|not found/i);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
